{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ZapConfig",
  "description": "Configuration schema for zap minimal prompt",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Path or URL to JSON schema for validation and autocompletion"
    },
    "directory": {
      "type": "object",
      "description": "Path and directory rendering configuration",
      "additionalProperties": false,
      "properties": {
        "home_symbol": {
          "type": "string",
          "default": "~",
          "description": "Replacement symbol for the user home directory"
        },
        "home_color": {
          "type": "string",
          "$ref": "#/definitions/Color",
          "default": "cyan",
          "description": "Color used for the directory path"
        }
      }
    },
    "character": {
      "type": "object",
      "description": "Prompt indicator character configuration",
      "additionalProperties": false,
      "properties": {
        "success_symbol": {
          "type": "string",
          "default": ">",
          "description": "Symbol rendered when the exit code is 0"
        },
        "success_color": {
          "type": "string",
          "$ref": "#/definitions/Color",
          "default": "bold green",
          "description": "Color of the symbol on success"
        },
        "error_symbol": {
          "type": "string",
          "default": ">",
          "description": "Symbol rendered on non-zero exit code"
        },
        "error_color": {
          "type": "string",
          "$ref": "#/definitions/Color",
          "default": "bold red",
          "description": "Color of the symbol on error"
        }
      }
    }
  },
  "definitions": {
    "Color": {
      "type": "string",
      "enum": [
        "black",
        "red",
        "green",
        "yellow",
        "blue",
        "magenta",
        "cyan",
        "white",
        "bright black",
        "bright red",
        "bright green",
        "bright yellow",
        "bright blue",
        "bright magenta",
        "bright cyan",
        "bright white",
        "bold black",
        "bold red",
        "bold green",
        "bold yellow",
        "bold blue",
        "bold magenta",
        "bold cyan",
        "bold white"
      ]
    }
  }
}
